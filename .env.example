# API Configuration
#
# VITE_ENABLE_MOCKS=true -> the app starts an in-browser mock API (MSW,
# src/mocks/) instead of calling a real backend. No server process needed —
# works identically in local dev and a static deployment (e.g. Render Static Site).
VITE_ENABLE_MOCKS=true

# Leave empty while mocking (relative /api/... paths, intercepted by the
# mock service worker). Once deploying against a real backend, set this to
# its URL and set VITE_ENABLE_MOCKS=false (or remove it), then rebuild.
VITE_API_URL=
VITE_ENDPOINT=
