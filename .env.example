# API Configuration
#
# LOCAL_MOCK_DATA=true  -> server.js serves mock API responses itself (mock/index.js), no separate backend needed.
# LOCAL_MOCK_DATA=false -> server.js proxies /api/* requests to BACKEND_URL (a real backend).
LOCAL_MOCK_DATA=true

# Only used when LOCAL_MOCK_DATA=false. Example: https://api.yourapp.com
BACKEND_URL=

# Leave both empty so the frontend calls relative /api/... paths (same-origin in
# production, proxied by Vite to the local API server in dev). Only set these if
# the frontend needs to call an API on a different origin than the one serving it.
VITE_API_URL=
VITE_ENDPOINT=
